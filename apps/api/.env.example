DATABASE_URL="postgresql://pakbooks:pakbooks@localhost:5432/pakbooks?schema=public"
JWT_SECRET="change-this-long-random-secret"
PORT=4000
FRONTEND_URL="http://localhost:3000"
UPLOAD_DIR="uploads"

# AI provider layer. Leave as mock for local fallback parser; set one provider for real AI.
# Valid values: mock | openai | anthropic | gemini
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# OCR provider. mock returns a safe placeholder; google-vision calls Google Vision REST; tesseract calls local CLI.
# Valid values: mock | google-vision | tesseract
OCR_PROVIDER="mock"
GOOGLE_VISION_API_KEY=""
TESSERACT_BIN="tesseract"
TESSERACT_LANG="eng+urd"
